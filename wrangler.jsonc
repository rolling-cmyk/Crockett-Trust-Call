
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crockett-trust-call",
  "main": "workers.js",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ctc-app",
      "database_id": "PASTE_DATABASE_ID"
    }
  ]
}
